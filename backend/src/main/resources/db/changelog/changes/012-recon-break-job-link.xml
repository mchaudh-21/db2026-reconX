<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      TICKET-ADV069
      Associates reconciliation breaks with the job that produced them.
      The column remains nullable so existing recon_breaks rows remain valid.
    -->
    <changeSet id="012-add-job-id-to-recon-breaks" author="philemon">

        <addColumn tableName="recon_breaks">
            <column name="job_id" type="VARCHAR(36)"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="recon_breaks"
                baseColumnNames="job_id"
                constraintName="fk_recon_breaks_job"
                referencedTableName="recon_jobs"
                referencedColumnNames="job_id"/>

        <createIndex
                tableName="recon_breaks"
                indexName="idx_recon_breaks_job_id">
            <column name="job_id"/>
        </createIndex>

        <rollback>
            <dropIndex
                    tableName="recon_breaks"
                    indexName="idx_recon_breaks_job_id"/>

            <dropForeignKeyConstraint
                    baseTableName="recon_breaks"
                    constraintName="fk_recon_breaks_job"/>

            <dropColumn
                    tableName="recon_breaks"
                    columnName="job_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
